# Domain Health Monitor — backend configuration
#
# Copy this file to:
#     %APPDATA%\Domain Health Monitor\config.env
# (paste that path into Explorer's address bar), fill in the real values, save,
# then start Domain Health Monitor.
#
# This file is read ONLY by the backend process. Nothing here is compiled into the
# UI, and none of these values are ever sent to the browser or to the React code.

# ── Backend HTTP port ─────────────────────────────────────────────────────────
# Must match the port used in GOOGLE_REDIRECT_URI below.
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local server, or a full Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/domain_health

# ── Google OAuth (Postmaster Tools) ───────────────────────────────────────────
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (Application type: Web application).
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# This EXACT string must also be listed under "Authorized redirect URIs" on that
# OAuth client in Google Cloud. Do not change it unless you also change it there.
GOOGLE_REDIRECT_URI=http://localhost:5000/api/postmaster/oauth/callback

# ── Optional performance tuning (safe defaults shown) ─────────────────────────
# Domains checked simultaneously during a health check.
# HEALTH_CHECK_CONCURRENCY=20
# Postmaster API calls in flight at once.
# POSTMASTER_CONCURRENCY=6
# Blacklist (DNSBL) rate limit — domains per rolling hour.
# DNSBL_MAX_PER_HOUR=120
# How often the DNSBL queue drains, in milliseconds.
# DNSBL_TICK_MS=60000
# Parallel DNSBL DNS lookups.
# DNSBL_CONCURRENCY=50

# ── Development only ──────────────────────────────────────────────────────────
# Where the OAuth callback returns the user when running `npm run dev` in a browser.
# LEAVE THIS UNSET for the desktop application: the packaged app shows its own
# "you can close this tab" page instead of redirecting to a Vite dev server.
# FRONTEND_URL=http://localhost:5173
